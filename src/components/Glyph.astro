---
// One Kit module drawn small: section marks, nav markers, the 404.
import { modules, faces, shadow, order, iso } from '../lib/iso';
import type { Verb } from '../data/site';
interface Props { verb: Verb; size?: number; class?: string }
const { verb, size = 64, class: cls } = Astro.props;
const s = 10;
const boxes = modules[verb];
const corners = [iso(0, 0, 0, s), iso(4, 0, 0, s), iso(0, 4, 0, s), iso(4, 4, 0, s), iso(0, 0, 4, s), iso(4, 4, 4, s)];
const xs = corners.map((p) => p[0]); const ys = corners.map((p) => p[1]);
const vb = `${Math.min(...xs) - 14} ${Math.min(...ys) - 4} ${Math.max(...xs) - Math.min(...xs) + 28} ${Math.max(...ys) - Math.min(...ys) + 10}`;
---
<svg class:list={['glyph', cls]} viewBox={vb} width={size} height={size} aria-hidden="true" focusable="false" style={`--c:var(--v-${verb})`} data-glyph={verb}>
  <g class="glyph__shadow">
    {boxes.map((b) => <polygon points={shadow(b, s, -0.55, -0.25)} />)}
  </g>
  <g class="glyph__body">
    {order(boxes).map((b) => {
      const f = faces(b, s);
      return (
        <g class={b.top === 'green' ? 'is-green' : undefined}>
          <polygon points={f.left} class="f-left" />
          <polygon points={f.right} class="f-right" />
          <polygon points={f.top} class="f-top" />
        </g>
      );
    })}
  </g>
</svg>
