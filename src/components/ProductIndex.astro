---
// The product catalogue: coded rows on the left, the hovered product's cover lowered into the frame on the right.
// Used on the home page (the three flagships, with a row to the full list) and on /work/ (all seven).
import Pic from './Pic.astro';
import Cover from './Cover.astro';
import type { Case } from '../data/site';
interface Props { items: Case[]; more?: { href: string; code: string; label: string } }
const { items, more } = Astro.props;
---
<div class="index" data-index>
  <ol class="index__list">
    {items.map((c, i) => (
      <li>
        <a class="row" href={`/work/${c.slug}/`} data-row={i} data-label={c.name} data-code={c.code}>
          <span class="row__code">{c.code}</span>
          <span class="row__name">{c.name}</span>
          <span class="row__line">{c.oneLiner}</span>
          <span class="row__live"><span class="row__dot" aria-hidden="true"></span>{c.status.startsWith('Live prototype') ? 'Live prototype' : c.status} <span class="row__host">{new URL(c.live).hostname.split('.').slice(-2).join('.')}</span></span>
          <span class="row__thumb" aria-hidden="true"><Pic src={`covers/${c.cover}.png`} alt="" widths={[480, 800, 1200]} sizes="(max-width: 767px) 92vw, 1px" /></span>
        </a>
      </li>
    ))}
    {more && (
      <li class="index__more">
        <a class="more" href={more.href} data-label="All products" data-code="RD">
          <span class="more__code">{more.code}</span>
          <span class="more__label">{more.label}</span>
          <span class="more__arrow" aria-hidden="true">&#8594;</span>
        </a>
      </li>
    )}
  </ol>
  <div class="index__preview" aria-hidden="true">
    <div class="index__frame">
      {items.map((c, i) => (
        <div class="index__img" data-preview={i}>
          <Cover slug={c.cover} alt="" widths={[800, 1200]} sizes="42vw" />
        </div>
      ))}
      <p class="index__hint">Point at a product</p>
    </div>
  </div>
</div>
