---
import { verbs, site } from '../data/site';
import Module from './Module.astro';
interface Props { page: string }
const { page } = Astro.props;
const current = (id: string) => (id === 'build' && page === 'build') || (id === 'sit' && page === 'about') || (id === 'read' && page === 'work');
---
<header class="hdr" data-hdr>
  <a class="hdr__home" href="/" data-label="Shreeraj Narwade" data-code="00">
    <span class="hdr__name">Shreeraj Narwade</span>
    <span class="hdr__role">Product designer</span>
  </a>
  <nav class="hdr__nav" aria-label="Main">
    <ul>
      {verbs.map((v) => (
        <li>
          <a class="verb" href={v.href} data-verb={v.id} data-label={v.label} data-code={v.code} aria-current={current(v.id) ? 'page' : undefined}>
            <Module verb={v.id} size={30} small eager class="verb__glyph" />
            <span class="verb__stack"><span class="verb__text" data-text={v.label}>{v.label}</span><span class="verb__nav">{v.nav}</span></span>
          </a>
        </li>
      ))}
    </ul>
  </nav>
  <button class="hdr__menu" type="button" aria-expanded="false" aria-controls="menu" data-menu-btn>
    <span class="hdr__menu-label">Menu</span>
  </button>
</header>
<div class="menu" id="menu" hidden data-menu data-lenis-prevent role="dialog" aria-modal="true" aria-label="Menu">
  <nav aria-label="Mobile">
    <ul class="menu__list">
      {verbs.map((v, i) => (
        <li style={`--i:${i}`}>
          <a class="menu__item" href={v.href} data-verb={v.id} data-label={v.label} data-code={v.code} data-menu-link aria-current={current(v.id) ? 'page' : undefined}>
            <span class="menu__code">{v.code}</span>
            <span class="menu__label">{v.label}</span>
            <span class="menu__line">{v.line}</span>
            <Module verb={v.id} size={56} small class="menu__mod" />
          </a>
        </li>
      ))}
    </ul>
    <div class="menu__foot">
      <p class="menu__k">Write to me</p>
      <a class="menu__mail" href={`mailto:${site.email}`}>{site.email}</a>
      <ul class="menu__more">
        <li><a href={site.resume} data-menu-link data-label="Resume" data-code="CV">Resume</a></li>
        <li><a href={site.socials[0].href} target="_blank" rel="noopener" aria-describedby="newtab">LinkedIn <span aria-hidden="true">&#8599;</span></a></li>
      </ul>
    </div>
  </nav>
</div>
