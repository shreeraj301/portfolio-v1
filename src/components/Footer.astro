---
import { site } from '../data/site';
import Glyph from './Glyph.astro';
const year = 2026;
---
<footer class="ftr" id="gather" data-section="gather">
  <div class="ftr__top">
    <p class="code">GT / Contact</p>
    <h2 class="ftr__verb" data-set>Gather</h2>
    <Glyph verb="gather" size={120} class="ftr__glyph" />
  </div>
  <p class="ftr__lead">Hiring a product designer, or want a second pair of eyes on a flow? Write to me.</p>
  <a class="ftr__mail" href={`mailto:${site.email}`} data-fill>
    <span class="btn__fill" aria-hidden="true"></span>
    <span class="ftr__mail-text">{site.email}</span>
  </a>
  <div class="ftr__grid">
    <div>
      <p class="code">Elsewhere</p>
      <ul class="ftr__list">
        {site.socials.map((s) => <li><a class="util" href={s.href} rel="me noopener" target="_blank" aria-describedby="newtab">{s.label}</a></li>)}
      </ul>
    </div>
    <div>
      <p class="code">Documents</p>
      <ul class="ftr__list">
        <li><a class="util" href={site.resume} target="_blank" aria-describedby="newtab" rel="noopener">Resume</a></li>
        <li><a class="util" href={site.showreel} target="_blank" aria-describedby="newtab" rel="noopener">Showreel, 90s</a></li>
        <li><a class="util" href="https://otla-pages-lofi.vercel.app" target="_blank" aria-describedby="newtab" rel="noopener">Otla Pages</a></li>
      </ul>
    </div>
    <div class="ftr__sun">
      <p class="code">Light on the plaza</p>
      <p class="ftr__clock"><span data-sun-clock>15:20</span></p>
      <p class="ftr__note">A simulated sun. The shadows in the drawing up top follow it while you read, and lean toward your pointer.</p>
    </div>
  </div>
  <div class="ftr__base">
    <p>&copy; {year} {site.name}. Based in {site.based}.</p>
    <p>Set in Archivo, Newsreader and IBM Plex Mono. Built with Astro and GSAP.</p>
  </div>
</footer>
