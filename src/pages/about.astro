---
import Base from '../layouts/Base.astro';
import Pic from '../components/Pic.astro';
import SectionHead from '../components/SectionHead.astro';
import { site, about } from '../data/site';
import { otlaNote, marked } from '../data/sit';
---
<Base page="about" title="About" description="About Shreeraj Narwade: architect-trained product designer and design engineer from India. Experience, education, tools and how I work.">
  <section class="sec apage" style="--c:var(--v-sit)">
    <SectionHead verb="sit" id="about-title" as="h1" code="ST / About" line="Pull up a seat on the otla." note={otlaNote} />
    <div class="apage__grid">
      <figure class="apage__portrait">
        <Pic src="avatar-trim.png" alt="Illustrated portrait of Shreeraj: smiling, in glasses, a blue shirt and a grey jacket" widths={[360, 560, 800]} sizes="(max-width: 767px) 66vw, 30vw" loading="eager" fetchpriority="high" />
      </figure>
      <div class="apage__text">
        {about.intro.map((p, i) => i === 0
          ? <p class="apage__lead" data-marks>{marked(p).map((x) => x.k ? <mark class="hl" data-k={x.k}>{x.t}</mark> : x.t)}</p>
          : <p>{p}</p>)}
        <div class="apage__ctas">
          <a class="btn" href="/resume/" data-fill data-label="Resume" data-code="CV"><span class="btn__fill" aria-hidden="true"></span><span class="btn__text">Read my resume</span></a>
          <a class="link" href={`mailto:${site.email}`}>{site.email}</a>
        </div>
        <p class="apage__where code">Based in {site.based}. {site.relocate}.</p>
      </div>
    </div>

    <a class="reel" href={site.showreel} target="_blank" aria-describedby="newtab" rel="noopener" data-reveal="clip">
      <span class="reel__img"><Pic src="showreel.jpg" alt="" widths={[640, 1280]} sizes="(max-width: 767px) 92vw, 60vw" /></span>
      <span class="reel__label"><span class="code">Showreel, 2026, 90 seconds</span><span class="reel__title">How I think and what I make&nbsp;<span aria-hidden="true">&#8599;</span></span></span>
    </a>

    <h2 class="apage__h2">Timeline</h2>
    <div class="tl" data-tl>
      <span class="tl__rail" aria-hidden="true"><span class="tl__fill"></span></span>
      <ol class="tl__list">
        {about.timeline.map((t) => (
          <li class="tl__item" data-kind={t.kind}>
            <p class="tl__when code">{t.when}</p>
            <span class="tl__mark" aria-hidden="true"></span>
            <p class="tl__text"><strong>{t.what}.</strong> <span>{t.line}</span></p>
          </li>
        ))}
      </ol>
      <p class="tl__key code" aria-hidden="true"><span data-kind="design"><i></i>Design</span><span data-kind="arch"><i></i>Architecture</span><span data-kind="study"><i></i>Study</span></p>
    </div>

    <h2 class="apage__h2">Tools and methods</h2>
    <dl class="tools">
      {about.tools.map((t) => <div data-reveal="up"><dt class="code">{t.group}</dt><dd>{t.items}</dd></div>)}
    </dl>

  </section>
</Base>
