---
import Base from '../layouts/Base.astro';
import Cluster from '../components/Cluster.astro';
import Glyph from '../components/Glyph.astro';
import Pic from '../components/Pic.astro';
import SectionHead from '../components/SectionHead.astro';
import { site, verbs, statement, cases, experiments, thesis, books, essays, otla, about } from '../data/site';
const words = statement.split(' ');
---
<Base page="home">
  <section class="hero" data-section="hero" aria-labelledby="hero-title">
    <div class="hero__meta" data-reveal="fade" data-intro data-delay="0.5">
      <p><span class="code">Sheet 00</span> Portfolio, 2026</p>
      <p><span class="code">Now</span> {site.now}</p>
      <p><span class="code">Sun on the plaza</span> <span data-sun-clock>15:20</span>, simulated</p>
    </div>
    <h1 class="hero__name" id="hero-title">
      <span class="hero__line" data-split="chars" data-intro>Shreeraj</span>
      <span class="hero__line" data-split="chars" data-intro data-delay="0.08">Narwade</span>
    </h1>
    <p class="hero__lead" data-split="lines" data-intro data-delay="0.35">
      Architect turned product designer. I design for how people think and decide, from AI tools to fintech.
    </p>
    <div class="hero__stage" data-stage>
      <Cluster />
      <p class="hero__caption" data-reveal="fade" data-intro data-delay="1.2">Six modules from my thesis kit, one for each thing you can do here.</p>
      <button class="recast" type="button" data-recast hidden>Put the modules back</button>
      <p class="hero__exploded" data-exploded aria-hidden="true">Exploded axonometric: every part lifted to show how it is put together</p>
    </div>
    <ol class="hero__verbs" aria-label="What you can do here">
      {verbs.map((v, i) => (
        <li data-reveal="up" data-intro data-delay={(0.55 + i * 0.06).toFixed(2)}>
          <a href={v.href} class="hv" data-verb={v.id} data-label={v.label} data-code={v.code}>
            <span class="hv__code">{v.code}</span>
            <span class="hv__label">{v.label}</span>
            <span class="hv__line">{v.line}</span>
            <span class="hv__arrow" aria-hidden="true">&#8600;</span>
          </a>
        </li>
      ))}
    </ol>
  </section>

  <section class="statement" aria-label="How I work">
    <p class="statement__text" data-words>
      {words.map((w) => <span class="w">{w} </span>)}
    </p>
    <p class="statement__by"><span class="code">From my showreel</span> <a class="link" href={site.showreel} target="_blank" aria-describedby="newtab" rel="noopener">Watch it, 90 seconds</a></p>
  </section>

  <section class="sec read" id="read" data-section="read" aria-labelledby="read-title">
    <SectionHead verb="read" id="read-title" code="RD-01 to RD-06" line="Six case studies. Research first, then decisions with their costs, then a prototype you can open." />
    <div class="index" data-index>
      <ol class="index__list">
        {cases.map((c, i) => (
          <li>
            <a class="row" href={`/work/${c.slug}/`} data-row={i} data-label={c.name} data-code={c.code}>
              <span class="row__code">{c.code}</span>
              <span class="row__name">{c.name}</span>
              <span class="row__line">{c.oneLiner}</span>
              <span class="row__ev">{c.evidence}</span>
              <span class="row__thumb" aria-hidden="true"><Pic src={`work/${c.cover}`} alt="" widths={[480, 800]} sizes="(max-width: 767px) 92vw, 1px" /></span>
            </a>
          </li>
        ))}
      </ol>
      <div class="index__preview" aria-hidden="true">
        <div class="index__frame">
          {cases.map((c, i) => (
            <div class="index__img" data-preview={i}>
              <Pic src={`work/${c.cover}`} alt="" widths={[800, 1200]} sizes="42vw" />
            </div>
          ))}
          <p class="index__hint">Point at a study</p>
        </div>
      </div>
    </div>
  </section>

  <section class="sec play" id="play" data-section="play" aria-labelledby="play-title">
    <SectionHead verb="play" id="play-title" code="PL-01 to PL-11" line="Things I built to learn: a gravity sandbox, two games, a synth, a decision tool. All live, all built with AI tools from my specs." />
    <ul class="play__grid">
      {experiments.filter((x) => x.kind !== 'Practice').map((x, i) => (
        <li class:list={['card', i < 2 && 'card--big']} data-reveal="up" data-delay={((i % 3) * 0.06).toFixed(2)}>
          <a href={x.href} target="_blank" aria-describedby="newtab" rel="noopener" class="card__link">
            <span class="card__media"><Pic src={x.img} alt={`Screenshot of ${x.name}`} widths={[480, 800]} sizes="(max-width: 767px) 92vw, 40vw" /></span>
            <span class="card__meta"><span class="code">{x.code}</span><span class="card__kind">{x.kind}</span></span>
            <span class="card__name">{x.name} <span class="card__arrow" aria-hidden="true">&#8599;</span></span>
            <span class="card__line">{x.line}</span>
          </a>
        </li>
      ))}
    </ul>
    <div class="briefs">
      <p class="code">Practice briefs, built to learn Figma Make</p>
      <ul>
        {experiments.filter((x) => x.kind === 'Practice').map((x) => (
          <li><a class="brief" href={x.href} target="_blank" aria-describedby="newtab" rel="noopener"><span class="code">{x.code}</span><span class="brief__name">{x.name}</span><span class="brief__line">{x.line}</span><span class="card__arrow" aria-hidden="true">&#8599;</span></a></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="sec build" id="build" data-section="build" aria-labelledby="build-title">
    <SectionHead verb="build" id="build-title" code="BD-01 to BD-06" line="Five years of architecture. The thesis that taught me to design for behaviour, not for form." />
    <div class="build__stage">
      <figure class="build__hero" data-reveal="scale">
        <div class="build__img" ><div data-parallax="0.08"><Pic src="build/kit-cover.jpg" alt="Cover of The Kit, Manual 01: an isometric render of coloured precast modules with steps, planters and an arch" widths={[800, 1200, 1600]} sizes="(max-width: 767px) 92vw, 50vw" /></div></div>
      </figure>
      <div class="build__text">
        <p class="code">BD-01 / Thesis</p>
        <h3 class="build__title" data-split="lines">{thesis.title}</h3>
        <p class="build__q" data-split="lines">{thesis.question}</p>
        <p>{thesis.kit}</p>
        <a class="btn" href="/build/" data-fill data-label="Build" data-code="BD"><span class="btn__fill" aria-hidden="true"></span><span class="btn__text">Walk through the thesis</span></a>
      </div>
    </div>
    <ul class="build__strip" aria-label="Modules from The Kit">
      {[['kit-balance', 'To Balance'], ['kit-sit', 'To Sit'], ['kit-play', 'To Play'], ['kit-perform', 'To Perform']].map(([f, l], i) => (
        <li data-reveal="up" data-delay={(i * 0.07).toFixed(2)}>
          <div class="strip__img"><Pic src={`build/${f}.jpg`} alt={`Render of a ${l} module from The Kit`} widths={[480, 800]} sizes="(max-width: 767px) 46vw, 23vw" /></div>
          <p class="code">{l}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="sec pause" id="pause" data-section="pause" aria-labelledby="pause-title">
    <SectionHead verb="pause" id="pause-title" code="PS-01 to PS-04" line="Four books of poems, essays on intuition and taste, and a hand-drawn library to keep them in." />
    <div class="pause__grid">
      <ul class="shelf" aria-label="Poetry books">
        {books.map((b, i) => (
          <li style={`--c:var(--v-${b.tone}); --i:${i}`} data-reveal="up" data-delay={(i * 0.07).toFixed(2)}>
            <a class="spine" href={b.href} target="_blank" aria-describedby="newtab" rel="noopener">
              <span class="spine__title">{b.title}</span>
              <span class="spine__code">PS-0{i + 1}</span>
              <span class="sr-only">, poetry book</span>
            </a>
          </li>
        ))}
      </ul>
      <div class="pause__side">
        <a class="otla" href={otla.href} target="_blank" aria-describedby="newtab" rel="noopener">
          <span class="code">Otla Pages</span>
          <span class="otla__title">A hand-drawn digital library <span aria-hidden="true">&#8599;</span></span>
          <span class="otla__line">{otla.line}</span>
        </a>
        <p class="code pause__label">Essays on Substack</p>
        <ul class="essays">
          {essays.map((e) => (
            <li><a href={e.href} target="_blank" aria-describedby="newtab" rel="noopener" class="essay"><span class="essay__title">{e.title}</span><span class="essay__line">{e.line}</span></a></li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="sec sit" id="sit" data-section="sit" aria-labelledby="sit-title">
    <SectionHead verb="sit" id="sit-title" code="ST" line="Who is behind the work." />
    <div class="sit__grid">
      <figure class="sit__portrait" data-reveal="scale"><Pic src="avatar.png" alt="Illustrated portrait of Shreeraj, smiling, in glasses" widths={[400, 800]} sizes="(max-width: 767px) 60vw, 22vw" /></figure>
      <p class="sit__lead" data-split="lines">{about.intro[0]}</p>
      <div class="sit__side">
        <p>{about.intro[1]}</p>
        <a class="btn" href="/about/" data-fill data-label="Sit" data-code="ST"><span class="btn__fill" aria-hidden="true"></span><span class="btn__text">More about me</span></a>
      </div>
    </div>
  </section>
</Base>
