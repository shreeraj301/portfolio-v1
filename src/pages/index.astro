---
import Base from '../layouts/Base.astro';
import Cluster from '../components/Cluster.astro';
import Pic from '../components/Pic.astro';
import Cover from '../components/Cover.astro';
import SectionHead from '../components/SectionHead.astro';
import ProductIndex from '../components/ProductIndex.astro';
import { site, verbs, statement, cases, experiments, thesis, books, essays, otla, about } from '../data/site';
import { otlaNote, marked } from '../data/sit';
const words = statement.split(' ');
// Read on the home page shows the three flagship products; the rest live on /work/.
const featured = cases.slice(0, 3);
const pad = (n: number) => String(n).padStart(2, '0');
// Two big cards, then rows of three. If the last row would hold two, those two are big too.
const plays = experiments.filter((x) => x.kind !== 'Practice');
const lastBig = (plays.length - 2) % 3 === 2 ? 2 : 0;
const words7 = ['zero', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine', 'ten'][cases.length] ?? String(cases.length);
---
<Base page="home">
  <section class="hero" id="hero" data-section="hero" aria-labelledby="hero-title">
    <div class="hero__meta">
      <p><span class="code">Sheet 00</span> Portfolio, 2026</p>
      <p><span class="code">Now</span> {site.now}</p>
    </div>
    <h1 class="hero__name" id="hero-title" aria-label={site.name}>
      <span class="hero__line">Shreeraj</span>
      <span class="hero__line">Narwade</span>
    </h1>
    <p class="hero__lead">
      Architect turned product designer. I design for how people think and decide, from AI tools to fintech.
    </p>
    <div class="hero__stage" data-stage>
      <Cluster />
      <p class="hero__caption hero__caption--plain">Six ways in. No hard hat required.</p>
      <button class="recast" type="button" data-recast hidden>Put the modules back</button>
      <p class="hero__exploded" data-exploded aria-hidden="true">Exploded axonometric: every part lifted to show how it is put together</p>
    </div>
    <ol class="hero__verbs" aria-label="What you can do here">
      {verbs.map((v) => (
        <li>
          <a href={v.href} class="hv" data-verb={v.id} data-label={v.label} data-code={v.code}>
            <span class="hv__code">{v.code}</span>
            <span class="hv__label">{v.label}</span>
            <span class="hv__line">{v.line}</span>
            <span class="hv__arrow" aria-hidden="true">&#8600;</span>
          </a>
        </li>
      ))}
    </ol>
  </section>

  <nav class="explore" data-explore aria-label="Explore">
    <ol class="explore__list">
      <li><a class="explore__kit" href="#hero">The kit</a></li>
      {verbs.map((v) => (
        <li>
          <a href={v.href} data-verb={v.id} data-label={v.label} data-code={v.code} style={`--c:var(--v-${v.id})`}>
            <span class="explore__verb">{v.label}</span>
            <span class="explore__nav">{v.nav}</span>
          </a>
        </li>
      ))}
      <li>
        <a class="explore__surprise" href="/work/found-it/" data-label="Found It" data-code="RD-01">
          <span class="explore__verb">Surprise me</span>
          <span class="explore__nav">Poorly supervised curiosity.</span>
        </a>
      </li>
    </ol>
  </nav>

  <section class="statement" aria-label="How I work">
    <p class="statement__text" data-words>
      {words.map((w, i) => <span class="w">{i < words.length - 1 ? `${w} ` : w}</span>)}
    </p>
    <p class="statement__by"><span class="code">From my showreel</span> <a class="link" href={site.showreel} target="_blank" aria-describedby="newtab" rel="noopener">Watch it, 90 seconds</a></p>
  </section>

  <section class="sec read" id="read" data-section="read" aria-labelledby="read-title">
    <SectionHead verb="read" id="read-title" code={`RD-01 to RD-${pad(featured.length)} of ${pad(cases.length)}`} line="Seven products and prototypes I designed and built. All live, open to explore." />
    <ProductIndex items={featured} more={{ href: '/work/', code: `RD-${pad(featured.length + 1)} to ${pad(cases.length)}`, label: `See all ${words7} products` }} />
  </section>

  <section class="sec build" id="build" data-section="build" aria-labelledby="build-title">
    <SectionHead verb="build" id="build-title" code="BD-01 to BD-06" line="Five years of architecture. The thesis that taught me to design for behaviour, not for form." />
    <div class="build__stage">
      <figure class="build__hero">
        <div class="build__img kitc" data-kit-cluster>
          <img class="kitc__still" src="/kit/cluster.webp" width="1400" height="1400" alt="The Kit in 3D: eight precast modules from my thesis locked together into one piece, with steps, planters, a shelf, an amphitheatre and a bridge" loading="lazy" decoding="async" draggable="false" />
          <p class="kitc__title" aria-hidden="true"><span class="code">Manual 01</span><span class="kitc__name">The Kit</span></p>
          <p class="kitc__piece code" aria-hidden="true" data-kit-piece></p>
        </div>
      </figure>
      <div class="build__text">
        <p class="code">BD-01 / Thesis</p>
        <h3 class="build__title" data-split="lines">{thesis.title}</h3>
        <p class="build__q" data-split="lines">{thesis.question}</p>
        <p>{thesis.kit}</p>
        <a class="btn" href="/build/" data-fill data-label="Build" data-code="BD"><span class="btn__fill" aria-hidden="true"></span><span class="btn__text">Walk through the thesis</span></a>
      </div>
    </div>
    <ul class="build__strip" aria-label="Modules from The Kit">
      {[['tile-read', 'To Read'], ['tile-play', 'To Play'], ['tile-gather', 'To Perform'], ['tile-sit', 'To Sit']].map(([f, l], i) => (
        <li data-reveal="up" data-delay={(i * 0.07).toFixed(2)}>
          <div class="strip__img" data-tile-turn={`/kit/${f}-turn.webp`}><Pic src={`build/${f}.png`} alt={`A ${l} module from The Kit, modelled in 3D`} widths={[480, 800]} sizes="(max-width: 767px) 46vw, 23vw" /></div>
          <p class="code">{l}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="sec pause" id="pause" data-section="pause" aria-labelledby="pause-title">
    <SectionHead verb="pause" id="pause-title" code="PS-01 to PS-04" line="Four books of poems, and essays on intuition and taste." />
    <div class="pause__grid">
      <ul class="shelf" aria-label="Poetry books">
        {books.map((b, i) => (
          <li data-reveal="up" data-delay={(i * 0.07).toFixed(2)}>
            <a class="bookc" href={b.href} target="_blank" aria-describedby="newtab" rel="noopener">
              <span class="bookc__img"><Pic src={`covers/book-${['universe', 'window', 'heart', 'zones'][i]}.png`} alt="" widths={[320, 480, 640]} sizes="(max-width: 899px) 44vw, 12vw" /></span>
              <span class="bookc__code code">PS-0{i + 1}</span>
              <span class="sr-only">{b.title}, poetry book</span>
            </a>
          </li>
        ))}
      </ul>
      <div class="pause__side">
        <a class="otla" href={otla.href} target="_blank" aria-describedby="newtab" rel="noopener">
          <span class="code">Otla Pages</span>
          <span class="otla__title">A hand-drawn digital library <span aria-hidden="true">&#8599;</span></span>
          <span class="otla__line">{otla.line}</span>
        </a>
        <p class="code pause__label">Essays on Substack</p>
        <ul class="essays">
          {essays.map((e) => (
            <li><a href={e.href} target="_blank" aria-describedby="newtab" rel="noopener" class="essay"><span class="essay__title">{e.title}</span><span class="essay__line">{e.line}</span></a></li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="sec play" id="play" data-section="play" aria-labelledby="play-title">
    <SectionHead verb="play" id="play-title" code={`PL-01 to PL-${pad(experiments.length)}`} line="Things I built to learn and have some fun." />
    <ul class="play__grid">
      {plays.map((x, i) => (
        <li class:list={['card', (i < 2 || i >= plays.length - lastBig) && 'card--big']} data-reveal="up" data-delay={((i % 3) * 0.06).toFixed(2)}>
          <a href={x.href} target="_blank" aria-describedby="newtab" rel="noopener" class="card__link">
            <span class="card__media"><Cover slug={`play-${x.img.replace(/^play\/|\.jpg$/g, '')}`} alt={`${x.name}, running live`} widths={[480, 800, 1200]} sizes="(max-width: 767px) 92vw, 40vw" /></span>
            <span class="card__meta"><span class="code">{x.code}</span><span class="card__kind">{x.kind}</span></span>
            <span class="card__name">{x.name} <span class="card__arrow" aria-hidden="true">&#8599;</span></span>
            <span class="card__line">{x.line}</span>
          </a>
        </li>
      ))}
    </ul>
    <div class="briefs">
      <p class="code">Practice briefs, built to learn Figma Make</p>
      <ul>
        {experiments.filter((x) => x.kind === 'Practice').map((x) => (
          <li><a class="brief" href={x.href} target="_blank" aria-describedby="newtab" rel="noopener"><span class="code">{x.code}</span><span class="brief__name">{x.name}</span><span class="brief__line">{x.line}</span><span class="card__arrow" aria-hidden="true">&#8599;</span></a></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="sec sit" id="sit" data-section="sit" aria-labelledby="sit-title">
    <SectionHead verb="sit" id="sit-title" code="ST" line="Pull up a seat on the otla." note={otlaNote} />
    <div class="sit__grid">
      <div class="sit__text">
        <p class="sit__lead" data-marks>{marked(about.intro[0]).map((x) => x.k ? <mark class="hl" data-k={x.k}>{x.t}</mark> : x.t)}</p>
        <p class="sit__more">{about.intro[1]}</p>
        <a class="btn" href="/about/" data-fill data-label="About" data-code="ST"><span class="btn__fill" aria-hidden="true"></span><span class="btn__text">More about me</span></a>
      </div>
      <figure class="sit__portrait" data-reveal="scale"><Pic src="avatar-trim.png" alt="Illustrated portrait of Shreeraj, smiling, in glasses" widths={[400, 800]} sizes="(max-width: 899px) 60vw, 30vw" /></figure>
    </div>
  </section>
</Base>
